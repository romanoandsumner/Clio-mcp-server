{
    "name": "clio-mcp-server",
    "version": "1.2.0",
    "description": "MCP server integrating Claude.ai with Clio Manage API v4",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js --external:express --external:axios --external:dotenv --external:zod --external:zod/v4 --external:@modelcontextprotocol/sdk --external:docx --external:exceljs --external:jszip --external:form-data --external:jose --external:pg --external:multer --external:puppeteer-core",
        "start": "npm run build && node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "oauth:static-client": "node scripts/generate-oauth-credentials.mjs static-client",
        "oauth:api-key": "node scripts/generate-oauth-credentials.mjs api-key"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.1",
        "axios": "^1.7.9",
        "docx": "^8.5.0",
        "dotenv": "^16.4.7",
        "esbuild": "^0.20.0",
        "exceljs": "^4.4.0",
        "express": "^4.21.2",
        "form-data": "^4.0.1",
        "jose": "^6.0.0",
        "jszip": "^3.10.1",
        "multer": "^2.0.1",
        "pg": "^8.13.0",
        "puppeteer-core": "^23.11.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.10.5",
        "@types/pg": "^8.11.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.7.3",
        "vitest": "^4.1.8"
    }
}
