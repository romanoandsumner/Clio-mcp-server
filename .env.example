PORT=3000

# --- Clio API ---
CLIO_BASE_URL=https://app.clio.com
CLIO_API_BASE_URL=https://app.clio.com/api/v4
# Same Clio OAuth app the platform uses — needed to REFRESH per-user tokens.
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=

# --- Clio Grow API (Clio Platform app — separate from the Manage app above) ---
# Created in the developer portal (developers.api.clio.com). Register the
# redirect URL <PUBLIC_BASE_URL>/grow/oauth/callback on the app. Attorneys
# connect at <PUBLIC_BASE_URL>/grow/oauth/start; tokens land in the vault
# under provider 'clio_grow'. All optional — without credentials, Grow tools
# fall back to the Manage token.
GROW_CLIENT_ID=
GROW_CLIENT_SECRET=
# GROW_API_BASE_URL=https://api.clio.com/grow
# The portal app page shows the authoritative OAuth endpoints — override if
# they differ from these defaults:
# GROW_OAUTH_AUTHORIZE_URL=https://developers.api.clio.com/oauth/authorize
# GROW_OAUTH_TOKEN_URL=https://developers.api.clio.com/oauth/token
# Space-separated Grow scopes; must be a SUBSET of the app's App Permissions in
# the portal. Leave unset to request the full default set the tools need:
# GROW_OAUTH_SCOPE=grow_lead_inbox_read grow_lead_inbox_write grow_custom_action_read grow_custom_action_write grow_matter_read grow_matter_note_read grow_matter_note_write grow_contact_read grow_contact_note_read grow_contact_note_write grow_user_read
# GROW_REDIRECT_URI=<PUBLIC_BASE_URL>/grow/oauth/callback

# --- Platform vault (shared Postgres holding per-user, encrypted Clio tokens) ---
# Connect as the NON-superuser role `noe_app` so row-level security is enforced.
# Append ?sslmode=require (or set DATABASE_SSL=true) when the DB requires TLS.
DATABASE_URL=postgresql://noe_app:<password>@<public-proxy-host>:<port>/railway
# 32-byte master key, base64-encoded. MUST be the SAME value as the platform.
APP_KEK_B64=

# --- Microsoft OAuth (per-user identity) ---
MS_TENANT_ID=
MS_CLIENT_ID=
# Only needed if the Microsoft app is a confidential (web) client.
MS_CLIENT_SECRET=
# Audience expected on the Microsoft v2 access token, e.g. api://<client-id>
MCP_AUDIENCE=api://<client-id>
# Required scope name, matched against `scp` (delegated) or `roles` (app)
MCP_SCOPE_NAME=mcp.access
# Onboarding allowlist: exact emails first, then domains. If BOTH are empty,
# every authenticated user is allowed (a warning is logged). Applies to BOTH
# the OAuth path and the static API keys below.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# --- OAuth client registration (see src/auth/oauthClients.ts) ---
# RFC 7591 Dynamic Client Registration at POST /register. Claude and ChatGPT
# use it to self-register; they receive MS_CLIENT_ID back as a public client
# and rely on PKCE. Set to false to stop advertising registration_endpoint and
# revert to connectors using a manually-entered client_id.
# OAUTH_DCR_ENABLED=true
# Optional strict allowlist for redirect URIs at /register (space- or
# comma-separated). Unset = accept any https/loopback URI and log it. Microsoft
# independently rejects any redirect_uri not on the app registration, so this
# is defence in depth. Example:
# OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback https://claude.com/api/mcp/auth_callback https://chatgpt.com/connector_platform_oauth_redirect

# --- Static OAuth client, for clients WITHOUT Dynamic Client Registration ---
# Gemini Enterprise cannot do DCR: it needs a fixed client_id + client_secret
# typed into its admin console. These are LOCAL to this server — /token
# verifies them and substitutes MS_CLIENT_ID/MS_CLIENT_SECRET upstream, so the
# Microsoft app secret never leaves the server and this pair can be revoked on
# its own. Generate with: npm run oauth:static-client
# Leave MCP_STATIC_CLIENT_ID empty to disable the static-client path entirely.
MCP_STATIC_CLIENT_ID=
# Set exactly one of these. The _SHA256 form is preferred — the deployment then
# holds no usable credential in plaintext. If both are set, the hash wins.
MCP_STATIC_CLIENT_SECRET=
MCP_STATIC_CLIENT_SECRET_SHA256=
# MCP_STATIC_CLIENT_NAME=Gemini Enterprise

# --- Static API keys (bypass OAuth entirely) ---
# For scripts/cron/curl that cannot run an OAuth flow. Comma- or
# newline-separated entries, each `email:secret` or `email:sha256:<hex>`.
# Presented as `Authorization: Bearer <key>` or `X-API-Key: <key>`. A key acts
# AS that attorney: the allowlist and their own Clio token still apply, so it
# grants nothing they could not already reach. Unset = the path is off.
# Generate with: npm run oauth:api-key -- someone@romanosumner.com
MCP_API_KEYS=
# Owner allowlist for the custom RomSum/NRN calendar EVENT TYPES. Comma-
# separated emails, case-insensitive. Users on this list can set custom event
# types via create_calendar_entry / update_calendar_entry; for everyone else
# those inputs are ignored. Calendar placement/reassignment is NOT gated by
# this (Clio enforces calendar write permission). If unset, defaults to the
# original author (see src/clio/owner.ts).
OWNER_EMAILS=

# Externally reachable origin of THIS server (used for OAuth discovery + downloads).
PUBLIC_BASE_URL=https://your-clio-mcp-host

# --- Bill PDF rendering (render_bill_pdf / download_bills_pdf) ---
# OPTIONAL. puppeteer-core bundles no browser; the server auto-detects a
# Chromium/Chrome binary on $PATH and in common locations (nixpacks.toml adds
# the `chromium` package, which lands on $PATH). Set this only to OVERRIDE the
# auto-detection with a specific binary. CHROMIUM_PATH / CHROME_PATH also accepted.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# --- Review UI (optional, unchanged) ---
ANTHROPIC_API_KEY=            # Required for /review AI-generated suggestions
REVIEW_PASSWORD=              # Password for /review UI (leave empty for no auth)

# --- Box (unchanged — out of scope) ---
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=

# --- Binary upload endpoint (POST /upload) ---
# Shared secret required in the X-Upload-Secret header. If unset, /upload
# rejects every request (fail closed). Use a long random value.
UPLOAD_SECRET=
